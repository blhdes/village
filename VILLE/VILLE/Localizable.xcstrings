    "Reviews come from members' public Letterboxd RSS feeds and belong to their authors. VILLE is not affiliated with or endorsed by Letterboxd." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reseñas vienen de los feeds RSS públicos de los miembros de Letterboxd y pertenecen a sus autores. VILLE no está afiliada a Letterboxd ni cuenta con su respaldo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kritiken stammen aus den öffentlichen Letterboxd-RSS-Feeds der Mitglieder und gehören ihren Urhebern. VILLE ist weder mit Letterboxd verbunden noch von Letterboxd unterstützt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les critiques proviennent des flux RSS publics des membres de Letterboxd et appartiennent à leurs auteurs. VILLE n’est ni affilié à Letterboxd, ni approuvé par Letterboxd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le recensioni provengono dai feed RSS pubblici dei membri di Letterboxd e appartengono ai loro autori. VILLE non è affiliata a Letterboxd né approvata da Letterboxd."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レビューはLetterboxdメンバーの公開RSSフィードから取得しており、著作権は各執筆者に帰属します。VILLEはLetterboxdと提携しておらず、Letterboxdの承認を受けたものでもありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As resenhas vêm dos feeds RSS públicos dos membros do Letterboxd e pertencem aos seus autores. O VILLE não é afiliado ao Letterboxd nem endossado por ele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影评来自 Letterboxd 成员的公开 RSS 订阅源，版权归各自作者所有。VILLE 与 Letterboxd 无关联，也未获得 Letterboxd 的认可。"
          }
        }
      }
    },

    },
    "Critics, writers, filmmakers and creators who post reviews often. Tap a name to read their reviews before following." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kritiker, Autoren, Filmschaffende und Creator, die oft Kritiken posten. Tippe auf einen Namen, um die Kritiken vor dem Folgen zu lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Críticos, escritores, cineastas y creadores que publican reseñas a menudo. Toca un nombre para leer sus reseñas antes de seguir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Critiques, écrivains, cinéastes et créateurs qui publient souvent. Touchez un nom pour lire ses critiques avant de suivre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Critici, scrittori, registi e creator che pubblicano spesso recensioni. Tocca un nome per leggere le recensioni prima di seguire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レビューをよく投稿する批評家、ライター、映画監督、クリエイター。名前をタップすると、フォローする前にレビューを読めます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Críticos, escritores, cineastas e criadores que publicam resenhas com frequência. Toque em um nome para ler as resenhas antes de seguir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经常发布影评的影评人、作家、电影人和创作者。轻点名字，可在关注前先读其影评。"
          }
        }
      }
    },

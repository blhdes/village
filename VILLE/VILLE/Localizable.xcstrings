    "Each member keeps their newest %lld reviews, plus every bookmark. Images take up to %@ and download again when needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von jedem Mitglied bleiben die %1$lld neuesten Kritiken, dazu alle Lesezeichen. Bilder belegen bis zu %2$@ und werden bei Bedarf neu geladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Each member keeps their newest %1$lld reviews, plus every bookmark. Images take up to %2$@ and download again when needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada miembro conserva sus %1$lld reseñas más recientes, además de todos los marcadores. Las imágenes ocupan hasta %2$@ y se vuelven a descargar cuando hacen falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque membre garde ses %1$lld critiques les plus récentes, plus tous les signets. Les images occupent jusqu’à %2$@ et se téléchargent à nouveau si besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di ogni membro restano le %1$lld recensioni più recenti, più tutti i segnalibri. Le immagini occupano fino a %2$@ e si riscaricano quando servono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メンバーごとに最新のレビュー%1$lld件と、すべてのブックマークを残します。画像は最大%2$@まで保存され、必要なときに再ダウンロードされます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada membro mantém as %1$lld resenhas mais recentes, além de todos os marcadores. As imagens ocupam até %2$@ e são baixadas de novo quando necessário."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每位成员保留最新的 %1$lld 篇影评，另加所有书签。图片最多占用 %2$@，需要时会重新下载。"
          }
        }
      }
    },

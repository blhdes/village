    "VILLE follows your iPhone. To read it in another language, tap and choose one under Language. Translations follow it too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VILLE folgt der Sprache deines iPhone. Für eine andere Sprache tippe hier und wähle unter „Sprache“ eine aus. Übersetzungen folgen ihr ebenfalls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VILLE usa el idioma de tu iPhone. Para leerla en otro, toca aquí y elige uno en «Idioma». Las traducciones también lo seguirán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VILLE suit la langue de votre iPhone. Pour l’utiliser dans une autre langue, touchez ici puis choisissez-en une sous « Langue ». Les traductions suivent aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VILLE segue la lingua del tuo iPhone. Per usarla in un’altra lingua, tocca qui e scegline una in “Lingua”. Anche le traduzioni la seguono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VILLEはiPhoneの言語に従います。別の言語で使うには、ここをタップして「言語」から選んでください。翻訳もその言語になります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VILLE segue o idioma do seu iPhone. Para usá-lo em outro idioma, toque aqui e escolha um em “Idioma”. As traduções também seguem essa escolha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VILLE 跟随 iPhone 的语言。如需使用其他语言，请轻点此处，然后在“语言”中选择。翻译也会随之改变。"
          }
        }
      }
    },

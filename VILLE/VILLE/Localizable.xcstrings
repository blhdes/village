              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Kritiken mit weniger als %lld Wörtern, etwa Einzeiler, erscheinen nicht im Feed. Die in deinen Lesezeichen bleiben."
                }

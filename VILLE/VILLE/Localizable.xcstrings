    },
    "The feed ends after this many reviews. Keep reading from the end card, or come back later for a new session." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El feed termina tras este número de reseñas. Sigue leyendo desde la tarjeta final o vuelve más tarde para una nueva sesión."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Feed endet nach so vielen Kritiken. Lies auf der Schlusskarte weiter oder komm später für eine neue Sitzung zurück."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fil s’arrête après ce nombre de critiques. Continuez la lecture depuis la carte de fin, ou revenez plus tard pour une nouvelle session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il feed finisce dopo questo numero di recensioni. Continua a leggere dalla scheda finale o torna più tardi per una nuova sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この数のレビューでフィードが終わります。終わりのカードから続けて読むか、あとで戻って新しいセッションを始めましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O feed termina depois dessa quantidade de resenhas. Continue lendo pelo cartão final ou volte mais tarde para uma nova sessão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读完这么多篇影评后，信息流就会结束。可以在结束页继续阅读，或稍后回来开始新的一轮。"
          }
        }
      }
    },
    "The people you follow haven't posted reviews recently. Add more people to fill your feed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las personas que sigues no han publicado reseñas últimamente. Añade a más gente para llenar tu feed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Personen, denen du folgst, haben in letzter Zeit keine Kritiken gepostet. Füge weitere hinzu, um deinen Feed zu füllen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes que vous suivez n’ont pas publié de critiques récemment. Ajoutez-en d’autres pour remplir votre fil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le persone che segui non hanno pubblicato recensioni di recente. Aggiungine altre per riempire il tuo feed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォロー中のメンバーは最近レビューを投稿していません。メンバーを追加してフィードを充実させましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {

    "That's every review saved so far. New ones arrive when your members post." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esas son todas las reseñas guardadas hasta ahora. Llegarán más cuando publiquen las personas que sigues."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das waren alle bisher gespeicherten Kritiken. Neue kommen, sobald die Personen, denen du folgst, etwas posten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce sont toutes les critiques enregistrées jusqu’ici. De nouvelles arriveront quand les personnes que vous suivez publieront."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste sono tutte le recensioni salvate finora. Ne arriveranno di nuove quando le persone che segui pubblicheranno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みのレビューはこれで全部です。フォロー中のメンバーが投稿すると、新しいレビューが届きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essas são todas as resenhas salvas até agora. Novas chegam quando as pessoas que você segue publicarem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前保存的影评都在这里了。你关注的成员发布新影评后，就会出现在这里。"
          }
        }
      }
    },
    "The end" : {
      "localizations" : {
        "es" : {

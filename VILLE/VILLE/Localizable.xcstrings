    "Tap the bookmark under a review to keep it here, on this iPhone. It stays even if you stop following its author." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe unter einer Kritik auf das Lesezeichen, um sie hier zu behalten, auf diesem iPhone. Sie bleibt, auch wenn du der Person, die sie geschrieben hat, nicht mehr folgst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el marcador bajo una reseña para guardarla aquí, en este iPhone. Se queda aunque dejes de seguir a quien la escribió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le signet sous une critique pour la garder ici, sur cet iPhone. Elle reste même si vous ne suivez plus la personne qui l’a écrite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il segnalibro sotto una recensione per tenerla qui, su questo iPhone. Resta anche se smetti di seguire chi l’ha scritta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レビューの下のブックマークをタップすると、このiPhoneのここに残せます。書いた人のフォローをやめても消えません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no marcador abaixo de uma resenha para guardá-la aqui, neste iPhone. Ela fica mesmo se você deixar de seguir quem a escreveu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点影评下方的书签，即可把它留在这台 iPhone 上。即使不再关注作者，它也会保留。"
          }
        }
      }
    },
    "Tap to show it" : {
      "localizations" : {

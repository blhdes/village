    "Alternative posters picks a different one from TMDB each time, like other countries’ releases. Tap any poster to flip to the next." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Alternative Poster“ wählt jedes Mal ein anderes von TMDB, etwa von Kinostarts in anderen Ländern. Tippe auf ein Poster, um zum nächsten zu wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «Carteles alternativos», cada vez sale otro de TMDB, como los de estrenos en otros países. Toca cualquier cartel para pasar al siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Affiches alternatives » en choisit une autre sur TMDB à chaque fois, comme celles des sorties à l’étranger. Touchez une affiche pour passer à la suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Locandine alternative” ne sceglie una diversa da TMDB ogni volta, come quelle delle uscite in altri paesi. Tocca una locandina per passare alla successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「別バージョンのポスター」をオンにすると、他の国の公開版など、TMDBから毎回別のポスターを選びます。ポスターをタップすると次のポスターに切り替わります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Pôsteres alternativos” escolhe um diferente do TMDB a cada vez, como os de lançamentos em outros países. Toque em qualquer pôster para passar ao próximo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“其他版本海报”后，每次都会从 TMDB 选一张不同的海报，比如其他国家上映时的版本。轻点任意海报即可切换到下一张。"
          }
        }
      }
    },

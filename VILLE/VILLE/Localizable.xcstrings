    "Reviews under ^[%lld words](inflect: true), like one-liners, stay out of the feed. Bookmarks keep them." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",

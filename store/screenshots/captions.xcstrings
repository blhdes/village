{
  "sourceLanguage": "en-US",
  "strings": {
    "Film reviews, one at a time": {
      "comment": "Shot 1. Every caption breaks its lines where \\n says (two lines at most) and has no final full stop: the template adds it.",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Film reviews,\none at a time"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Críticas de cine,\nuna a una"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Filmkritik\nnach der anderen"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Des critiques\nde films, une à une"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recensioni di film,\nuna alla volta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映画レビューを、\nひとつずつ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resenhas de filmes,\numa de cada vez"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影评，一篇一篇读"
          }
        }
      }
    },
    "The words first": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The words first"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero,\nlas palabras"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst die Worte"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots d’abord"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima le parole"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、言葉から"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro,\nas palavras"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字优先"
          }
        }
      }
    },
    "No spoilers until you tap": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "No spoilers\nuntil you tap"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin spoilers\nhasta que toques"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Spoiler,\nbis du tippst"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun spoiler\navant de toucher"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente spoiler\nfinché non tocchi"
          }
